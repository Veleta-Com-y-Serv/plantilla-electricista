---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="seccion hoja">
    <div class="contenedor">
      <p class="etiqueta">Error 404</p>
      <p class="error-cifra mt-4" aria-hidden="true">404</p>
      <div class="cota mt-4 max-w-md" aria-hidden="true"></div>
      <div class="titular mt-10 max-w-3xl">
        <h1 class="titulo-seccion">Aquí no llega la corriente</h1>
        <p class="titular-texto">Puede que el enlace esté mal o que la página se haya movido.</p>
      </div>
      <div class="botones mt-8"><a class="btn" href="/">Volver al inicio</a></div>
    </div>
  </section>
</Base>
