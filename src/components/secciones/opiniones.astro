---
// Opiniones: la primera en grande, en la letra de titulares, con su autor y su nota («Avería, Tudela»); las demás en
// dos columnas con filete. `testimonios: [{texto, autor, nota}]`. Sin opiniones no se pinta. Nunca se inventan.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = s ? s.testimonios.filter((t) => t?.texto) : [];
const [primera, ...resto] = lista;
---

{
  s && primera && (
    <Seccion id={Astro.props.id} class="hoja hoja-filete">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="mb-10 lg:mb-16" />
      <figure class="cita-grande">
        <blockquote>«{primera.texto}»</blockquote>
        <figcaption class="cita-autor">
          {primera.autor}
          {primera.nota && <span class="cita-nota">, {primera.nota}</span>}
        </figcaption>
      </figure>
      {resto.length > 0 && (
        <ul class="opiniones-resto">
          {resto.map((t) => (
            <li>
              <figure>
                <blockquote class="opinion-texto">«{t.texto}»</blockquote>
                <figcaption class="cita-autor">
                  {t.autor}
                  {t.nota && <span class="cita-nota">, {t.nota}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
